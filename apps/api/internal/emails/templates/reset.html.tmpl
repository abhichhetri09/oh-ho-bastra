<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>Reset your password</title>
</head>
<body style="margin:0;padding:0;background:#faf8f4;color:#24201c;-webkit-text-size-adjust:100%;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">Choose a new password for your {{.StoreName}} account.</div>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#faf8f4;">
<tr><td align="center" style="padding:32px 16px;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:560px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;">

<tr><td style="padding:0 0 28px;">
<a href="{{.ShopURL}}" style="font-family:Georgia,'Times New Roman',serif;font-size:24px;color:#24201c;text-decoration:none;"><img src="{{.ShopURL}}/email/mark.png" width="17" height="17" alt="" style="display:inline-block;width:17px;height:17px;margin-right:7px;border:0;vertical-align:baseline;">{{.StoreName}}</a>
</td></tr>

<tr><td style="background:#ffffff;border:1px solid #e6e1d8;padding:32px 28px;">
<h1 style="margin:0 0 20px;font-family:Georgia,'Times New Roman',serif;font-weight:normal;font-size:28px;line-height:1.2;color:#24201c;">Reset your password</h1>
<p style="margin:0 0 12px;">{{.Greeting}}</p>
<p style="margin:0 0 24px;color:#4a423a;">Someone (we hope you) asked to reset the password for your {{.StoreName}} account. Choose a new one below. The link works once, for the next hour.</p>

<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 24px;">
<tr><td style="background:#24201c;">
<a href="{{.URL}}" style="display:inline-block;padding:12px 22px;font-size:14px;color:#faf8f4;text-decoration:none;">Choose a new password</a>
</td></tr>
</table>

<p style="margin:0;font-size:13px;color:#7a6f63;">If you didn't ask for this, ignore this email: your password stays as it is.</p>
</td></tr>

<tr><td style="padding:24px 4px 0;font-size:12px;color:#7a6f63;">
<a href="{{.ShopURL}}" style="color:#7a6f63;">{{.StoreName}}</a>
</td></tr>

</table>
</td></tr>
</table>
</body>
</html>
