POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ohhobastra

PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ohhobastra

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-a-secret
# Public URL of the site that serves /api (Vite proxies /api → API in local/dev)
BETTER_AUTH_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Google OAuth (optional). Redirect URI in Google Cloud Console:
#   http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "mock" serves a local test payment page instead of a real provider (Paytrail later)
PAYMENT_PROVIDER=mock
