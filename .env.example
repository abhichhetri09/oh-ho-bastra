# Wrap any value containing $ in single quotes (e.g. KEY='a$b'), or docker compose will try to expand it.

# api
PORT=5000

NODE_ENV=development

# In Docker Compose use hostname `db`; for a local (non-Docker) API use localhost.
DATABASE_URL=postgresql://<user>:<password>@db:5432/ohhobastra?sslmode=disable

# generate with: openssl rand -hex 32
JWT_REFRESH_SECRET=
JWT_ACCESS_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# the storefront's public url: stripe return pages, links in emails, and the
# web's canonical urls, sitemap and share images
FRONTEND_URL=http://localhost:3000
# comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For (e.g. your load
# balancer). Leave empty in dev so clients can't spoof their ip.
TRUSTED_PROXIES=
COOKIE_DOMAIN=localhost

OPENAPI_PATH=openapi.json

# --- Order emails (SMTP) ---------------------------------------------------
# Order confirmed, shipped and refunded emails. Without SMTP_HOST they stay
# queued (and go out once mail is set up, if under two days old).
# Development: the compose stack's Mailpit catches them (http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
# starttls (default, port 587), tls (port 465) or none (local catchers only)
SMTP_TLS=none
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM='Oh Ho Bastra <orders@example.com>'
# Production: any SMTP provider works (Resend, Postmark, Amazon SES...), e.g.
# SMTP_HOST=smtp.resend.com SMTP_PORT=587 SMTP_TLS=starttls
# SMTP_USERNAME=resend SMTP_PASSWORD=<api key>, and MAIL_FROM on a domain
# you have verified with the provider.

# postgres (used by the db container)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=ohhobastra

# seed: `bun run db:seed` creates an admin and a customer (passwords required, min 8 chars)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=
# `bun run db:seed:catalog` adds the tee catalog through the running API as
# the seeded admin (default URL: NEXT_PUBLIC_API_URL); its photos are uploaded
# to the CLOUDINARY_* cloud above
# SEED_API_URL=http://localhost:5000

# web
NEXT_PUBLIC_API_URL=http://localhost:5000
INTERNAL_API_URL=http://api:5000
# The store's look is picked in Admin → Settings; this is the fallback while
# the API can't be reached: editorial (default), studio or botanical
STORE_THEME=editorial
# true shows a floating theme picker for demos (visitors' picks persist in a
# cookie). Keep it off for a real store.
DEMO_THEME_PICKER=false

# --- Stripe (test mode) ---------------------------------------------------
# Without STRIPE_SECRET_KEY the API runs and checkout answers 503. The
# checkout return pages are built from FRONTEND_URL.
STRIPE_SECRET_KEY=
# Signing secret of the dashboard webhook endpoint (POST /api/v1/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=
# Local webhooks: the secret `stripe listen --print-secret` prints
STRIPE_WEBHOOK_SECRET_LOCAL=
