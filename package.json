{
  "name": "ohhobastra",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:go": "cd apps/api && golangci-lint run ./...",
    "test:go": "cd apps/api && go test ./...",
    "test:web": "cd apps/web && bun test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,yml,yaml,css}\"",
    "check-types": "turbo run check-types",
    "generate": "turbo run generate",
    "generate:check": "bun run scripts/check-generated.ts",
    "db:migrate": "cd apps/api && make migrate-up",
    "db:migrate:down": "cd apps/api && make migrate-down",
    "db:sqlc": "cd apps/api && make sqlc",
    "db:sqlc:check": "bun run scripts/check-sqlc.ts",
    "db:seed": "cd apps/api && make seed",
    "db:seed:catalog": "bun run scripts/seed-catalog.ts",
    "docker:dev:up": "docker compose --env-file .env.local -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose --env-file .env.local -f docker-compose.dev.yml down",
    "docker:dev:reset": "docker compose --env-file .env.local -f docker-compose.dev.yml down -v && bun run docker:dev:up",
    "prepush": "bun run check-types && bun run lint:go && bun run test:go && bun run test:web && bun run build",
    "ci": "bun run generate:check && bun run db:sqlc:check && bun run check-types && bun run lint && bun run lint:go && bun run test:go && bun run test:web && bun run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.8.1",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
